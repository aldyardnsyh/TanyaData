# TanyaData — environment
# Salin menjadi .env.local bila perlu. Tidak ada nilai rahasia yang di-commit.
# P6-FIX: variabel keamanan/deploy ditambahkan; semua nilai di bawah adalah
# placeholder atau contoh bukan-rahasia. Jangan commit kunci nyata.

# Direktori data seed (default: <cwd>/data)
# DATA_DIR=./data

# Direktori state writable (default lokal: <DATA_DIR>/workspace)
# WORKSPACE_DIR=./data/workspace

# Direktori backup SQLite (di luar WORKSPACE_DIR). Dipakai runbook backup/restore.
# BACKUP_DIR=./data/backups

# --- Profil seed ------------------------------------------------------------
# none (DEFAULT, WAJIB produksi) = image kosong: tanpa KB-SOP/Perpres/transaksi
#   dummy, 0 dokumen, Qdrant 0 point (no_documents=true, bukan FAIL).
# demo (development saja) = 4 KB-SOP + Perpres + 46.952 transaksi R&D.
# Nilai selain none|demo ditolak fail-closed. Lihat docs/PRODUCTION_READY.md.
SEED_PROFILE=none

# --- Origin & CORS (P6-FIX / SEC-003 / SP-3) -------------------------------
# Origin server untuk canonical URL DAN allow-list navigasi PDF.
# WAJIB di produksi (https). Boleh daftar dipisah koma untuk lokal.
# TIDAK boleh diisi dari Host / x-forwarded-* yang dikendalikan klien.
# APP_ORIGIN=https://tanyadata.contoh.app

# Allow-list origin frontend yang boleh memanggil /api/** lintas origin.
# Kosong → fallback ke APP_ORIGIN. Exact match, bukan wildcard.
# CORS_ALLOWED_ORIGINS=https://tanyadata.contoh.app,http://localhost:3000

# Origin backend yang dipakai frontend (Vercel). Tanpa /api, tanpa trailing slash.
# NEXT_PUBLIC_API_BASE_URL=https://api.contoh.local

# --- Guard deploy publik (P6-FIX / SEC-001) --------------------------------
# 1/true → aplikasi menolak semua request API bila API_ACCESS_TOKEN kosong.
# PUBLIC_DEPLOY=0
# Rahasia; hanya di VPS, diverifikasi reverse proxy sampai auth in-app tersedia.
# API_ACCESS_TOKEN=

# --- PDF export (P6-FIX / SEC-003) -----------------------------------------
# Binary Chromium/Chrome headless untuk render PDF.
# BROWSER_PDF_EXECUTABLE=/usr/bin/chromium
# Hanya untuk container VPS terpercaya (non-root + seccomp). Jangan dipakai
# bila origin bisa dikendalikan klien. Default: --no-sandbox DIMATIKAN.
# PDF_BROWSER_NO_SANDBOX=0

# --- Share snapshot (P6-FIX / SEC-002) -------------------------------------
# Umur share link dalam hari sebelum kedaluwarsa (default: 30).
# SHARE_TTL_DAYS=30

# --- LLM opsional — otomatis aktif mode `assist` bila kredensial terisi. ------
# Untuk Groq ([OI]-compatible): LLM_BASE_URL=https://api.groq.com/openai/v1,
# LLM_MODEL=openai/gpt-oss-120b, LLM_API_KEY=<dari console>. Jangan commit kunci.
# LLM_MODE: off = paksa deterministik; assist = fallback penutup (default bila
# kredensial ada); full = composer utama.
LLM_MODE=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Fallback berantai saat model utama kena 429/5xx/timeout/invalid.
# Error tidak dikembalikan ke pengguna; jawaban deterministik dipakai bila semua gagal.
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b
LLM_TIMEOUT_MS=12000
LLM_MAX_OUTPUT_TOKENS=900

# --- OCR on-demand — PP-OCRv6 tiny microservice (DECISION-034 / ADR-11) -----
# DEFAULT MATI. Nyalakan HANYA saat Fase A ingestion dokumen image-only, lalu
# matikan lagi sebelum embedding/Qdrant. JANGAN jalankan OCR + embedding
# bersamaan di VPS 2 GB — lihat deploy/ocr/README.md.
# true | false. false = adapter tidak dipanggil (jujur: ocr_skipped).
OCR_ENABLED=false
# Endpoint microservice OCR. WAJIB loopback; jangan expose ke publik.
OCR_ENDPOINT=http://127.0.0.1:6334/ocr
# Timeout keras per halaman di klien (ms). Harus LEBIH BESAR dari OCR_TIMEOUT_S
# di service (default 4000 ms) agar service sempat mengembalikan 504.
OCR_TIMEOUT_MS=5000
# Rahasia — bearer token yang SAMA dengan OCR_API_KEY di deploy/ocr.
# Jangan commit kunci nyata.
OCR_API_KEY=

# --- Retrieval: Qdrant secondary index (DECISION-033 / P3-MIGRATION) -------
# DEFAULT AKTIF: Qdrant ON + hybrid (dense + BM25) + embedding lokal e5-small.
# KONSTRAIN VPS: 2 vCPU / 2 GB RAM / 40 GB SSD — jejak RAM & latensi model
# diukur sekali (lihat docs/QDRANT_BACKEND_IMPL.md). Bila terukur melebihi
# anggaran, turunkan ke sparse-only/fts5 lewat ADR baru, BUKAN diam-diam.
#
# CIRCUIT BREAKER (wajib): bila Qdrant tidak terjangkau, timeout, atau model
# lokal gagal dimuat/diunduh, aplikasi JANGAN mati — retrieval otomatis
# jatuh ke FTS5 deterministik dan `meta.fallbackReason` diisi (mis.
# `qdrant_unavailable`, `embedding_unavailable`). Jalur FTS5 tetap terisi
# penuh dan menjadi jalur pemulihan. Kontrak sitasi tidak berubah.
#
# Opsi `off` sengaja DIPERTAHANKAN untuk debugging/parity: QDRANT_MODE=off,
# RETRIEVAL_MODE=fts5, EMBEDDING_PROVIDER=off → perilaku identik dengan
# implementasi sebelum migrasi (tanpa jaringan, tanpa model, tanpa Qdrant).
# Semua variabel di bawah HANYA di VPS. JANGAN pakai prefix NEXT_PUBLIC_ —
# frontend Vercel tidak pernah membuka koneksi ke port 6333.

# off | on | local | required.
# off = tidak ada koneksi sama sekali (mode debugging).
# on = aktif, circuit breaker ke FTS5 bila gagal (DEFAULT).
# local = alias on. required = aktif + API key wajib (fail-closed).
QDRANT_MODE=on
# Origin internal. Loopback bila container Qdrant satu host dengan backend.
QDRANT_URL=http://127.0.0.1:6333
# RAHASIA — hanya di VPS / secret manager. Jangan commit, jangan di log.
QDRANT_API_KEY=
# Alias yang dipakai aplikasi + collection fisik untuk swap atomik.
QDRANT_COLLECTION=td_chunks
QDRANT_COLLECTION_VERSION=v1
# Named vector "dense" dibuat tapi TIDAK dipakai saat EMBEDDING_PROVIDER=off.
# Harus sama dengan dimensi model bila Fase B diaktifkan (e5-small = 384).
QDRANT_VECTOR_SIZE=384
QDRANT_TIMEOUT_MS=5000
QDRANT_WAIT=true
QDRANT_BATCH_SIZE=64
# Nama field/vector yang dipakai adapter AIML (lib/ai/hybrid.ts).
QDRANT_TEXT_FIELD=text_fts
QDRANT_DENSE_VECTOR=dense
QDRANT_TOP_K=20

# fts5 | qdrant | hybrid (DEFAULT). hybrid = dense + BM25 dengan RRF di aplikasi.
# fts5 = jalur deterministik/fallback (juga dipakai eval offline).
RETRIEVAL_MODE=hybrid

# off | local (DEFAULT). local = Xenova/multilingual-e5-small, 384d, q8,
# tanpa API key. Bila model gagal dimuat → fallback FTS5 + meta.fallbackReason.
# Set 'off' untuk debugging tanpa model (tidak ada unduhan saat runtime).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIM=384
# Direktori model lokal (Fase B). Kosong → cache default transformers.js.
EMBEDDING_CACHE_DIR=
# Jangan aktifkan unduhan model di runtime; siapkan file model di VPS.
EMBEDDING_ALLOW_REMOTE=0
EMBEDDING_TIMEOUT_MS=15000
