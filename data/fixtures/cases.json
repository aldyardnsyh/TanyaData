    {
      "id": "EV-D01",
      "fr": "D",
      "capability": "citation",
      "question": "Klik sitasi membuka halaman+bagian+potongan; sitasi tanpa chunk ditolak",
      "input": {
        "registry": {
          "documents": { "uud-1945": { "status": "READY", "pageCount": 10, "rev": "a1b2c3d4" } },
          "chunks": {
            "chk-33": {
              "document_id": "uud-1945",
              "section_path": "Pasal 33/Ayat (1)",
              "page": 10,
              "text": "Perekonomian disusun sebagai usaha bersama berdasar atas asas kekeluargaan.",
              "parse_ok": true,
              "ocr_status": null,
              "rev": "a1b2c3d4"
            }
          }
        },
        "cases": [
          {
            "parts": { "docId": "uud-1945", "page": 10, "section": "Pasal 33/Ayat (1)", "chunk": "chk-33", "rev": "a1b2c3d4" },
            "quote": "Perekonomian disusun sebagai usaha bersama"
          },
          {
            "parts": { "docId": "uud-1945", "page": 10, "section": "Pasal 33/Ayat (1)", "chunk": "", "rev": "a1b2c3d4" }
          }
        ]
      },
      "expected": {
        "results": [
          { "valid": true },
          { "valid": false, "reason": "MISSING_CHUNK" }
        ]
      },
      "tolerance": { "citation_hit": 0.9, "fake_citation": 0 },
      "tags": ["citation", "deep_link", "normal"]
    },
    {
      "id": "EV-D02",
      "fr": "D",
      "capability": "citation",
      "question": "Tanpa bukti valid → refused; kutipan diubah dan rev lama ditolak",
      "input": {
        "registry": {
          "documents": { "fin-q3-2026": { "status": "READY", "pageCount": 2, "rev": "deadbeef" } },
          "chunks": {
            "fin-aruskas": {
              "document_id": "fin-q3-2026",
              "section_path": "Arus kas operasi/Q3 2026",
              "page": 2,
              "text": "Arus kas operasi: 22300000000 IDR Q3 2026",
              "parse_ok": true,
              "rev": "deadbeef"
            }
          }
        },
        "cases": [
          {
            "parts": { "docId": "fin-q3-2026", "page": 2, "section": "Arus kas operasi/Q3 2026", "chunk": "fin-aruskas", "rev": "deadbeef" },
            "quote": "999999"
          },
          {
            "parts": { "docId": "fin-q3-2026", "page": 2, "section": "Arus kas operasi/Q3 2026", "chunk": "fin-aruskas", "rev": "wrongrev" }
          }
        ]
      },
      "expected": {
        "results": [
          { "valid": false, "reason": "QUOTE_MISMATCH" },
          { "valid": false, "reason": "REV_MISMATCH" }
        ]
      },
      "tolerance": { "refusal_correctness": 0.95, "foreign_numbers": 0, "false_guardrail": 0.02 },
      "tags": ["citation", "refused", "adversarial"]
    },

